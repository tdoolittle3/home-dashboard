# Copy to .env and fill in. .env is gitignored - never commit it.

# --- this app ---
# Port the server listens on inside the container. The host publishes it on 80
# (stacks/dash in home-automation). Keep this above 1024: the container runs as
# the non-root `node` user.
PORT=8099
HOST=0.0.0.0
DASHBOARD_CONFIG=./config/dashboard.json

# --- Home Assistant (required) ---
# Long-lived access token: HA -> your profile -> Security -> Long-lived access tokens.
# This token has full control of HA. It stays server-side and is never sent to the browser.
HA_BASE_URL=http://192.168.0.13:8123
HA_TOKEN=replace-me

# --- Frigate (optional) ---
# The unauthenticated API on :5000. LAN only - never port-forward it.
FRIGATE_BASE_URL=http://192.168.0.13:5000

# --- Jellyfin (optional) ---
# API key: Jellyfin -> Dashboard -> API Keys.
JELLYFIN_BASE_URL=http://192.168.0.13:8096
JELLYFIN_API_KEY=

# --- Uptime Kuma (optional) ---
# Kuma has no documented REST API. This reads its Prometheus /metrics endpoint,
# which needs an API key (Settings -> API Keys). See README - unverified on 3001.
UPTIME_KUMA_BASE_URL=http://192.168.0.13:3001
UPTIME_KUMA_API_KEY=

# --- tuning ---
# How long a polled source result is reused before re-fetching.
SOURCE_TTL_SECONDS=10
# How often refreshed source data is pushed to connected browsers.
SOURCE_PUSH_SECONDS=15
