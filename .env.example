# Copy to .env and fill in. .env is gitignored - never commit it.

# --- this app ---
# Port the server listens on inside the container. The host publishes it on 80
# (stacks/dash in home-automation). Keep this above 1024: the container runs as
# the non-root `node` user.
PORT=8099
HOST=0.0.0.0
DASHBOARD_CONFIG=./config/dashboard.json

# --- Home Assistant (required) ---
# Long-lived access token: HA -> your profile -> Security -> Long-lived access tokens.
# This token has full control of HA. It stays server-side and is never sent to the browser.
HA_BASE_URL=http://192.168.0.13:8123
HA_TOKEN=replace-me

# --- Frigate (optional) ---
# The unauthenticated API on :5000. LAN only - never port-forward it.
FRIGATE_BASE_URL=http://192.168.0.13:5000
# The same Frigate as the BROWSER reaches it - detection rows redirect to its
# review UI (/review?id=...), which unlike a bare MP4 also plays in the
# standalone home-screen app. The phone is usually on the tailnet, so this is
# the tailnet name, not the LAN IP. Unset = rows open the proxied clip instead.
FRIGATE_PUBLIC_URL=http://ladybird.tail0e6756.ts.net:5000

# --- Jellyfin (optional) ---
# API key: Jellyfin -> Dashboard -> API Keys -> "+". Any name; the key is shown once.
JELLYFIN_BASE_URL=http://192.168.0.13:8096
JELLYFIN_API_KEY=

# --- Uptime Kuma (optional) ---
# Kuma has no documented REST API. This reads its Prometheus /metrics endpoint,
# which needs an API key: Settings -> API Keys -> Add. The key is the HTTP basic
# password; Kuma ignores the username.
UPTIME_KUMA_BASE_URL=http://192.168.0.13:3001
UPTIME_KUMA_API_KEY=

# --- Immich (optional) ---
# API key: Immich -> Account settings -> API Keys -> New. Create it while signed in
# as the ADMIN account: library totals and the job queue are admin-only endpoints,
# and a non-admin key gets version + disk figures but nothing else.
IMMICH_BASE_URL=http://192.168.0.13:2283
IMMICH_API_KEY=

# --- AdGuard Home (optional) ---
# The admin UI login - every /control/* endpoint wants it as HTTP basic auth,
# which is why the server polls AdGuard and the browser never talks to it.
# The dashboard only reads (status, stats, query log); it never toggles anything.
ADGUARD_BASE_URL=http://192.168.0.13:8053
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=

# --- Meshtastic (optional) ---
# The gateway node bridges the LoRa mesh onto the LAN Mosquitto with
# mqtt.json_enabled on (see home-automation docs/meshtastic.md). None of these
# are secrets - the JSON topics are plaintext on the LAN-only broker anyway.
# MESH_CHANNEL is the HOME channel's NAME (it is an uplink topic segment);
# MESH_CHANNEL_INDEX is the numeric index its sends go out on - a seed only:
# every channel's index (home included) is also learned from the `channel`
# field of uplink envelopes, and the panel can send on any channel it has
# heard. Keep NAME and INDEX in sync or sends leave on the wrong channel.
# MESH_GATEWAY_NODE is the gateway's decimal node number ("myNodeNum" in
# `meshtastic --info`); the firmware drops downlinks with any other `from`,
# and it only transmits on channels with downlink enabled in its own config.
# Leave GATEWAY_NODE unset for a read-only panel.
MESH_MQTT_URL=mqtt://192.168.0.13:1883
MESH_ROOT_TOPIC=msh/US
MESH_CHANNEL=homemesh
MESH_CHANNEL_INDEX=0
MESH_GATEWAY_NODE=

# --- tuning ---
# How long a polled source result is reused before re-fetching.
SOURCE_TTL_SECONDS=10
# How often refreshed source data is pushed to connected browsers.
SOURCE_PUSH_SECONDS=15

# --- llama-swap on snibbly (optional) ---
# The inference box. llama-swap gates everything except /health behind the keys
# in its config's `apiKeys` list, sent as a Bearer token; the dashboard only
# reads /v1/models (the catalogue) and /running (what holds VRAM) - it never
# loads or unloads anything. The key is LLAMA_API_KEY in snibbly's
# /etc/llama/llama.env (root:llama, needs sudo). LAN IP, same as the other
# server-facing URLs - snibbly's name only resolves over Tailscale MagicDNS.
#
# BASE_URL is the chat door: point it at LiteLLM (snibbly:8080) so /api/chat is
# captured by Langfuse. UI_BASE_URL is llama-swap itself (snibbly:9292) - only
# it serves /running (real load state) and the /ui and /upstream pages the
# status panel and the /snibbly proxy need, which LiteLLM 404s. Omit UI_BASE_URL
# for a plain single-port llama-swap (no LiteLLM in front) and both fall to BASE_URL.
LLAMA_SWAP_BASE_URL=http://192.168.0.19:8080
LLAMA_SWAP_UI_BASE_URL=http://192.168.0.19:9292
LLAMA_SWAP_API_KEY=

# --- whisper STT on ladybird (optional) ---
# whisper.cpp server (stacks/stt in home-automation, docs/stt.md). Gives the
# assistant its mic button; without it the button simply never renders. No
# key - the service is LAN-only and unauthenticated, like Frigate's API.
STT_BASE_URL=http://192.168.0.13:8990
